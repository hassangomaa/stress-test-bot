[Unit]
Description=Zaedl storefront visitor stress bot (exponential 10m ramp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stress-test-bot
Environment=PYTHONUNBUFFERED=1
Environment=STRESSBOT_TZ=Asia/Riyadh
ExecStart=/opt/stress-test-bot/.venv/bin/python -m stressbot run --profile zaedl-ramp-10m --url-key prod
Restart=always
RestartSec=30

# Resource caps — protect arheb/zaedl VPS from overload
CPUQuota=40%
MemoryMax=512M
MemoryHigh=384M
TasksMax=64
Nice=10
IOWeight=50

StandardOutput=append:/var/log/stress-test-bot.log
StandardError=append:/var/log/stress-test-bot.log

[Install]
WantedBy=multi-user.target
