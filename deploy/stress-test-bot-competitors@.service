[Unit]
Description=Competitor stress fleet worker (%i) — 9 parallel interval profiles
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stress-test-bot
Environment=PYTHONUNBUFFERED=1
Environment=STRESSBOT_TZ=Asia/Riyadh
Environment=STRESSBOT_NODE_ID=%i
Environment=STRESSBOT_LOG_DIR=/var/log/stress-test-bot/%i
ExecStart=/opt/stress-test-bot/.venv/bin/python -m stressbot run-multi --manifest competitors-all --url-key prod
Restart=always
RestartSec=15
CPUQuota=60%
MemoryMax=512M
MemoryHigh=448M
TasksMax=128
Nice=10
IOWeight=50
StandardOutput=append:/var/log/stress-test-bot/%i/orchestrator.log
StandardError=append:/var/log/stress-test-bot/%i/orchestrator.log

[Install]
WantedBy=multi-user.target
