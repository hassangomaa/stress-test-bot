# Copy to configs/competitor-gemini.env on VPS — do not commit secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1004451567214
COMPETITOR_LOOKUP_PATH=/var/www/zaedl/credentials/competitor-lookup.json
ZAEDL_ARTISAN=/var/www/zaedl/artisan

# Fleet SSH (remote visit counts from worker nodes)
FLEET_SSH_KEY_SLT_OCR=/root/.ssh/egyguests_vps
FLEET_SSH_USER_SLT_OCR=root
FLEET_SSH_HOST_SLT_OCR=69.62.114.63
FLEET_SSH_KEY_TTAKKA=/root/.ssh/cursor_ttakka
FLEET_SSH_USER_TTAKKA=deploy
FLEET_SSH_HOST_TTAKKA=187.124.9.225
# Password fallback only if key missing (legacy)
FLEET_SSH_PASS_TTAKKA=
